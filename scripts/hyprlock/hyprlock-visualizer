#!/usr/bin/env python3
import sys
import time
import math
import subprocess

def get_now_playing():
    try:
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode().strip()
        if status == "Playing":
            pos = float(subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL).decode().strip() or "0")
            return True, pos
    except Exception:
        pass
    return False, 0.0

playing, pos = get_now_playing()
bars = [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

if playing:
    # Generate dynamic spectrum bars based on playback position and time
    t = time.time() * 8.0 + pos * 4.0
    res = []
    for i in range(20):
        val = (math.sin(t + i * 0.7) + math.cos(t * 1.3 + i * 0.4) + 2.0) / 4.0
        idx = int(val * 7.99)
        idx = max(0, min(7, idx))
        res.append(bars[idx])
    print("".join(res))
else:
    # Idle subtle wave
    print(" ▂▃▄▅▆▇█▇▆▅▄▃▂ ")
