#!/usr/bin/env python3
import sys
import time
import math
import subprocess

MODE = "bars"
if len(sys.argv) > 1:
    MODE = sys.argv[1]

def get_now_playing():
    try:
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode().strip()
        if status == "Playing":
            pos = float(subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL).decode().strip() or "0")
            return True, pos
    except Exception:
        pass
    return False, 0.0

playing, pos = get_now_playing()

# Jumping vertical bars mode (36 dynamic bouncing spectrum bars)
chars = [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
if playing:
    t = time.time() * 9.0 + pos * 5.0
    res = []
    for i in range(36):
        v = (math.sin(t * 1.7 + i * 0.8) + math.cos(t * 2.5 + i * 0.5) + math.sin(t * 0.9 + i * 1.2) + 3.0) / 6.0
        idx = int(max(0, min(7, v * 7.99)))
        res.append(chars[idx])
    print("".join(res))
else:
    print(" ▂▃▄▅▆▇█▇▆▅▄▃▂  ▂▃▄▅▆▇█▇▆▅▄▃▂ ")
