#!/usr/bin/env bash
# hyprlock-visualizer: Real-time 32-band PipeWire audio FFT spectrum

PIDFILE="/tmp/hyprlock-cava-real.pid"

if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    python3 /home/amtia/.local/bin/hyprlock-cava-real-daemon >/dev/null 2>&1 &
fi

if [ -s /dev/shm/hyprlock-real-vis.txt ]; then
    cat /dev/shm/hyprlock-real-vis.txt
else
    echo "                                "
fi
