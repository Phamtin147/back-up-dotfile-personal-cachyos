#!/usr/bin/env python3
import time
import math
import subprocess

def get_now_playing():
    try:
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode().strip()
        if status == "Playing":
            pos = float(subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL).decode().strip() or "0")
            return True, pos
    except Exception:
        pass
    return False, 0.0

playing, pos = get_now_playing()
# Smooth braille liquid dots: ⣀ ⣄ ⣤ ⣶ ⣷ ⣿
chars = ["⣀", "⣄", "⣤", "⣶", "⣷", "⣿"]

if playing:
    t = time.time() * 5.0 + pos * 3.0
    half = []
    for i in range(10):
        val = (math.sin(t + i * 0.4) * math.cos(t * 0.8 + i * 0.3) + 1.0) / 2.0
        idx = max(0, min(5, int(val * 5.99)))
        half.append(chars[idx])
    left = "".join(half[::-1])
    right = "".join(half)
    print(f"{left}{right}")
else:
    print("⣀⣄⣤⣶⣷⣿⣿⣷⣶⣤⣄⣀")
