#!/usr/bin/env python3
import sys
import time
import math
import subprocess

MODE = "shade"
if len(sys.argv) > 1:
    MODE = sys.argv[1]

def get_now_playing():
    try:
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode().strip()
        if status == "Playing":
            pos = float(subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL).decode().strip() or "0")
            return True, pos
    except Exception:
        pass
    return False, 0.0

playing, pos = get_now_playing()

if MODE == "spark":
    sparks = ["·", "✧", "✦", "★", "✦", "✧", "·"]
    if playing:
        t = time.time() * 4.5 + pos * 2.0
        res = []
        for i in range(11):
            v = (math.sin(t + i * 0.5) + 1.0) / 2.0
            idx = int(v * 6.99)
            res.append(sparks[max(0, min(6, idx))])
        print("".join(res))
    else:
        print("· ✧ ✦ ★ ✦ ✧ ·")

elif MODE == "brackets":
    if playing:
        t = time.time() * 5.0 + pos * 2.5
        n1 = int((math.sin(t) + 1.0) * 3) + 2
        n2 = int((math.sin(t * 1.3 + 1.0) + 1.0) * 3) + 2
        l1 = "─" * n1
        l2 = "─" * n2
        print(f"[{l1} 󰎈 {l2}]")
    else:
        print("[─── 󰎈 ───]")

else: # "shade" - Shaded Block Gradient
    shades = [" ", "░", "▒", "▓", "█"]
    if playing:
        t = time.time() * 5.0 + pos * 2.5
        half = []
        for i in range(7):
            v = (math.sin(t + i * 0.4) * math.cos(t * 0.7 + i * 0.3) + 1.0) / 2.0
            idx = int(v * 4.99)
            half.append(shades[max(0, min(4, idx))])
        left = "".join(half[::-1])
        right = "".join(half)
        print(f"{left}{right}")
    else:
        print("░▒▓██▓▒░░▒▓██▓▒░")
