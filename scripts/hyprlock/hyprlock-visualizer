#!/usr/bin/env python3
import sys
import time
import math
import subprocess

MODE = "wave"
if len(sys.argv) > 1:
    MODE = sys.argv[1]

def get_now_playing():
    try:
        status = subprocess.check_output(["playerctl", "status"], stderr=subprocess.DEVNULL).decode().strip()
        if status == "Playing":
            pos = float(subprocess.check_output(["playerctl", "position"], stderr=subprocess.DEVNULL).decode().strip() or "0")
            return True, pos
    except Exception:
        pass
    return False, 0.0

playing, pos = get_now_playing()

if MODE == "dots":
    dots = ["•", "◦", "○", "◯", "○", "◦", "•"]
    if playing:
        t = time.time() * 4.0 + pos * 2.0
        res = []
        for i in range(24):
            idx = int((math.sin(t + i * 0.4) + 1.0) * 3.49)
            res.append(dots[max(0, min(6, idx))])
        print("".join(res))
    else:
        print("•◦○◯○◦••◦○◯○◦••◦○◯○◦•")

elif MODE == "pulse":
    if playing:
        t = time.time() * 5.0 + pos * 2.5
        n1 = int((math.sin(t) + 1.0) * 8) + 6
        n2 = int((math.sin(t * 1.4 + 1.0) + 1.0) * 8) + 6
        l1 = "─" * n1
        l2 = "─" * n2
        print(f"──{l1} 󰎈 {l2}──")
    else:
        print("──────── 󰎈 ────────")

else: # "wave" - Wide 36-bar Equalizer Wave
    chars = [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    if playing:
        t = time.time() * 6.0 + pos * 3.0
        res = []
        for i in range(36):
            v = (math.sin(t + i * 0.3) + math.cos(t * 1.5 + i * 0.2) + 2.0) / 4.0
            idx = int(max(0, min(7, v * 7.99)))
            res.append(chars[idx])
        print("".join(res))
    else:
        print(" ▂▃▄▅▆▇█▇▆▅▄▃▂  ▂▃▄▅▆▇█▇▆▅▄▃▂ ")
