#!/usr/bin/env python3
# Real-time CAVA PipeWire Audio FFT daemon
# bar_delimiter=0 means: each bar is 1 ascii digit (0-7), separated by null byte \x00
# Each frame ends with newline \x0a
# 32 bars per frame -> 32 digits + 31 null bytes + 1 newline = 64 bytes per frame
import os
import pty
import subprocess
import time

pid_file = "/tmp/hyprlock-cava-real.pid"
try:
    with open(pid_file, "w") as f:
        f.write(str(os.getpid()))
except Exception:
    pass

cava_config = os.path.expanduser("~/.config/cava/config-hyprlock-real")
tmp_path = "/dev/shm/hyprlock-real-vis.tmp"
shm_path = "/dev/shm/hyprlock-real-vis.txt"

master, slave = pty.openpty()
proc = subprocess.Popen(
    ["cava", "-p", cava_config],
    stdout=slave,
    stderr=subprocess.DEVNULL,
    stdin=subprocess.DEVNULL,
    close_fds=True,
)
os.close(slave)

bars = [
    "▂", "▂", "▃", "▄", "▅", "▆", "▇", "█"
]

raw = b""
while True:
    try:
        data = os.read(master, 512)
        if not data:
            time.sleep(0.01)
            continue
        raw += data
        while b"\n" in raw:
            frame, raw = raw.split(b"\n", 1)
            # Extract only ascii digit bytes (0x30-0x37), skip nulls and other bytes
            values = [b - 48 for b in frame if 48 <= b <= 55]
            if not values:
                continue
            out = "".join(bars[v] for v in values)
            if out:
                with open(tmp_path, "w") as f:
                    f.write(out)
                os.replace(tmp_path, shm_path)
    except Exception:
        time.sleep(0.01)
