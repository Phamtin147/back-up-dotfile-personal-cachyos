#!/usr/bin/env python3
# Real-time CAVA PipeWire Audio FFT daemon with POSIX Atomic RAM replace
import os
import pty
import subprocess
import time

pid_file = "/tmp/hyprlock-cava-real.pid"
try:
    with open(pid_file, "w") as f:
        f.write(str(os.getpid()))
except Exception:
    pass

cava_config = os.path.expanduser("~/.config/cava/config-hyprlock-real")
tmp_path = "/dev/shm/hyprlock-real-vis.tmp"
shm_path = "/dev/shm/hyprlock-real-vis.txt"

master, slave = pty.openpty()

proc = subprocess.Popen(
    ["cava", "-p", cava_config],
    stdout=slave,
    stderr=subprocess.DEVNULL,
    stdin=subprocess.DEVNULL,
    close_fds=True,
)
os.close(slave)

bars = [
    b"\xe2\x96\x82",  # Level 0 (▂ baseline)
    b"\xe2\x96\x82",  # Level 1 (▂)
    b"\xe2\x96\x83",  # Level 2 (▃)
    b"\xe2\x96\x84",  # Level 3 (▄)
    b"\xe2\x96\x85",  # Level 4 (▅)
    b"\xe2\x96\x86",  # Level 5 (▆)
    b"\xe2\x96\x87",  # Level 6 (▇)
    b"\xe2\x96\x88",  # Level 7 (█)
]

buffer = b""

while True:
    try:
        data = os.read(master, 256)
        if not data:
            time.sleep(0.01)
            continue
        buffer += data
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            line = line.strip()
            if not line:
                continue
            res = bytearray()
            for b in line:
                if 48 <= b <= 55:
                    res.extend(bars[b - 48])
                else:
                    res.extend(bars[0])
            with open(tmp_path, "wb") as f:
                f.write(bytes(res))
            os.replace(tmp_path, shm_path)
    except Exception:
        time.sleep(0.01)
