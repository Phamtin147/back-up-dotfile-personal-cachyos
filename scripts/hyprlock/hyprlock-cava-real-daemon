#!/usr/bin/env python3
# Real-time CAVA PipeWire Audio FFT daemon (32 Bands with 1-pixel Baseline)
import os
import pty
import subprocess
import time

cava_config = os.path.expanduser("~/.config/cava/config-hyprlock-real")
shm_path = "/dev/shm/hyprlock-real-vis.txt"

master, slave = pty.openpty()

proc = subprocess.Popen(
    ["cava", "-p", cava_config],
    stdout=slave,
    stderr=subprocess.DEVNULL,
    stdin=subprocess.DEVNULL,
    close_fds=True,
)
os.close(slave)

# 8 block heights: Level 0 = lowest 1/8 block " ", Level 7 = full block "█"
bars = [
    b"\xe2\x96\x81",  # Level 0 (1/8 height baseline)
    b"\xe2\x96\x82",  # Level 1 (2/8 height)
    b"\xe2\x96\x83",  # Level 2 (3/8 height)
    b"\xe2\x96\x84",  # Level 3 (4/8 height)
    b"\xe2\x96\x85",  # Level 4 (5/8 height)
    b"\xe2\x96\x86",  # Level 5 (6/8 height)
    b"\xe2\x96\x87",  # Level 6 (7/8 height)
    b"\xe2\x96\x88",  # Level 7 (8/8 full block)
]

buffer = b""

while True:
    try:
        data = os.read(master, 256)
        if not data:
            time.sleep(0.01)
            continue
        buffer += data
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            line = line.strip()
            if not line:
                continue
            res = bytearray()
            for b in line:
                if 48 <= b <= 55:
                    res.extend(bars[b - 48])
                else:
                    res.extend(bars[0])
            with open(shm_path, "wb") as f:
                f.write(bytes(res))
    except Exception:
        time.sleep(0.01)
