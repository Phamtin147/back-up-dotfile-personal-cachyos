#!/usr/bin/env bash
status=$(playerctl status 2>/dev/null) || exit 0
[ "$status" = "Playing" ] || exit 0

artist=$(playerctl metadata --format '{{xesam:artist}}' 2>/dev/null)
title=$(playerctl metadata --format '{{xesam:title}}' 2>/dev/null)
[ -n "$title" ] || exit 0

if [ -n "$artist" ]; then
    full="$title - $artist"
else
    full="$title"
fi

# Truncate if longer than 28 characters to prevent screen overflow
if [ ${#full} -gt 28 ]; then
    full="${full:0:25}..."
fi

printf '{"text":"  %s"}\n' "$full"
