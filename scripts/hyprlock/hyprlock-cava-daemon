#!/usr/bin/env bash
# hyprlock-cava-daemon: High-amplitude vertical bar height parser

cava -p "$HOME/.config/cava/config-hyprlock" 2>/dev/null | \
python3 -u -c "
import sys, os, io

# Map CAVA values directly to high-amplitude rising vertical blocks
# 0 -> ▂ (baseline), 1 -> ▃, 2 -> ▄, 3 -> ▅, 4 -> ▆, 5 -> ▇, 6 -> █, 7 -> █
bars = ['▂', '▃', '▄', '▅', '▆', '▇', '█', '█']

stdin = sys.stdin.buffer.raw if hasattr(sys.stdin.buffer, 'raw') else sys.stdin.buffer
buf = b''
while True:
    data = stdin.read(256)
    if not data:
        break
    buf += data
    while b'\n' in buf:
        frame, buf = buf.split(b'\n', 1)
        vals = [b - 48 for b in frame if 48 <= b <= 55]
        if len(vals) >= 32:
            out = ''.join(bars[v] for v in vals)
            try:
                with open('/tmp/cava-hyprlock.txt', 'w') as f:
                    f.write(out)
            except Exception:
                pass
"
