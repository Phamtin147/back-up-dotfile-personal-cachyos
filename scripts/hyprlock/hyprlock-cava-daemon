#!/usr/bin/env bash
# hyprlock-cava-daemon: Continuous CAVA spectrum writer with high vertical block height dynamics

cava -p "$HOME/.config/cava/config-hyprlock" 2>/dev/null | \
python3 -u -c "
import sys, os, io

# 8 block heights: Level 0 = lowest 1/8 block ' ', Level 7 = full block '█'
bars = [' ', '▂', '▃', '▄', '▅', '▆', '▇', '█']

stdin = sys.stdin.buffer.raw if hasattr(sys.stdin.buffer, 'raw') else sys.stdin.buffer
buf = b''
while True:
    data = stdin.read(256)
    if not data:
        break
    buf += data
    while b'\n' in buf:
        frame, buf = buf.split(b'\n', 1)
        vals = [b - 48 for b in frame if 48 <= b <= 55]
        if len(vals) >= 32:
            # Boost vertical height amplitude (1.8x gain so beats hit full block '█')
            boosted = [min(7, int(v * 1.8)) if v > 0 else 0 for v in vals]
            out = ''.join(bars[v] for v in boosted)
            try:
                with open('/tmp/cava-hyprlock.txt', 'w') as f:
                    f.write(out)
            except Exception:
                pass
"
