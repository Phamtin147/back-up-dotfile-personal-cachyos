#!/usr/bin/env bash
# niri-shader [effect-name|next|prev|list] - swap window open/close shader effect
set -euo pipefail

SHADERS_DIR="$HOME/shaders"
CONFIG_FILE="$HOME/.config/niri/cfg/animation.kdl"
STATE_FILE="$SHADERS_DIR/.current"
TMP_STATE="/tmp/niri-shader-state"

# Get sorted list of effects
mapfile -t EFFECTS < <(find "$SHADERS_DIR" -mindepth 1 -maxdepth 1 -type d ! -name ".*" -printf '%f\n' | sort)

if [ ${#EFFECTS[@]} -eq 0 ]; then
    echo "Error: No shaders found in $SHADERS_DIR" >&2
    exit 1
fi

apply_effect() {
    local EFFECT="$1"
    local EFFECT_DIR="$SHADERS_DIR/$EFFECT"
    local OPEN_FILE="$EFFECT_DIR/open.glsl"
    local CLOSE_FILE="$EFFECT_DIR/close.glsl"
    local CONFIG_FILE_SRC="$EFFECT_DIR/config"

    if [ ! -f "$OPEN_FILE" ] && [ -f "$EFFECT_DIR/$EFFECT.glsl" ]; then
        cp "$EFFECT_DIR/$EFFECT.glsl" "$OPEN_FILE"
        cp "$EFFECT_DIR/$EFFECT.glsl" "$CLOSE_FILE"
    fi

    if [ ! -f "$OPEN_FILE" ] || [ ! -f "$CLOSE_FILE" ]; then
        echo "Warning: Missing open.glsl or close.glsl for $EFFECT" >&2
        return 1
    fi

    OPEN=$(cat "$OPEN_FILE")
    CLOSE=$(cat "$CLOSE_FILE")

    DURATION=500
    CURVE="ease-out-cubic"
    if [ -f "$CONFIG_FILE_SRC" ]; then
        while IFS= read -r line; do
            case "$line" in
                duration-ms*) DURATION=$(echo "$line" | awk '{print $2}') ;;
                curve*)       CURVE=$(echo "$line" | awk '{print $2}' | tr -d '"') ;;
            esac
        done < "$CONFIG_FILE_SRC"
    fi

    cat > "$CONFIG_FILE" << ANIMEOF
animations {
        // $EFFECT effect khi mở cửa sổ
        window-open {
            custom-shader r"
$OPEN
            "
            duration-ms $DURATION
            curve "$CURVE"
        }
        // $EFFECT effect khi đóng cửa sổ
        window-close {
            custom-shader r"
$CLOSE
            "
            duration-ms $DURATION
            curve "$CURVE"
        }

        // Di chuyển cửa sổ
        window-movement {
            spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        }
        // Thay đổi kích thước cửa sổ
        window-resize {
            spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
        }
        // Thông báo cấu hình
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
        }
        // Giao diện chụp màn hình
        screenshot-ui-open {
            duration-ms 200
            curve "ease-out-quad"
        }
        // Chế độ xem tổng quan (Overview)
        overview-open-close {
            spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
        }
    }
ANIMEOF

    niri msg action load-config-file 2>/dev/null || true
    echo "$EFFECT" > "$STATE_FILE"
    echo "$EFFECT" > "$TMP_STATE" 2>/dev/null || true
    echo "Current: $EFFECT"
}

get_current() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    elif [ -f "$TMP_STATE" ]; then
        cat "$TMP_STATE"
    else
        echo ""
    fi
}

case "${1:-}" in
    next)
        CURRENT=$(get_current)
        IDX=-1

        if [ -n "$CURRENT" ]; then
            for i in "${!EFFECTS[@]}"; do
                if [ "${EFFECTS[$i]}" = "$CURRENT" ]; then
                    IDX=$i
                    break
                fi
            done
        fi

        if [ "$IDX" -eq -1 ]; then
            NEXT="${EFFECTS[0]}"
        else
            NEXT_IDX=$(( (IDX + 1) % ${#EFFECTS[@]} ))
            NEXT="${EFFECTS[$NEXT_IDX]}"
        fi

        apply_effect "$NEXT"
        ;;
    prev)
        CURRENT=$(get_current)
        IDX=-1

        if [ -n "$CURRENT" ]; then
            for i in "${!EFFECTS[@]}"; do
                if [ "${EFFECTS[$i]}" = "$CURRENT" ]; then
                    IDX=$i
                    break
                fi
            done
        fi

        if [ "$IDX" -eq -1 ]; then
            NEXT="${EFFECTS[-1]}"
        else
            PREV_IDX=$(( (IDX - 1 + ${#EFFECTS[@]}) % ${#EFFECTS[@]} ))
            NEXT="${EFFECTS[$PREV_IDX]}"
        fi

        apply_effect "$NEXT"
        ;;
    list)
        echo "Available effects (${#EFFECTS[@]} total):"
        CURRENT=$(get_current)
        for e in "${EFFECTS[@]}"; do
            if [ "$e" = "$CURRENT" ]; then
                echo "  * $e (active)"
            else
                echo "    $e"
            fi
        done
        ;;
    *)
        if [ $# -eq 0 ]; then
            echo "Usage: niri-shader <effect-name|next|prev|list>"
            echo ""
            echo "Available effects:"
            for e in "${EFFECTS[@]}"; do
                echo "  $e"
            done
            exit 1
        fi

        EFFECT="$1"
        if [ ! -d "$SHADERS_DIR/$EFFECT" ]; then
            echo "Error: effect '$EFFECT' not found" >&2
            echo "Available:"
            for e in "${EFFECTS[@]}"; do
                echo "  $e"
            done
            exit 1
        fi

        apply_effect "$EFFECT"
        ;;
esac
