// ────────────── Output Configuration ──────────────
// Xem thêm tại: https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

output "HDMI-A-1" {
    mode "2560x1440@74.932" 
    scale 1.5
    position x=0 y=0
}

output "eDP-1" {
    mode "2560x1600@165.004" 
    scale 1.75
    position x=1706 y=0
    
    // Vị trí (nếu dùng nhiều màn hình)
    // position x=0 y=0
    
    // Xoay màn hình (normal, 90, 180, 270, flipped-90, v.v.)
    // transform "normal"
}
