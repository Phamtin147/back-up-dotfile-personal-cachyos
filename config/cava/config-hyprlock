[general]
bars = 64
framerate = 60
autosens = 1
sensitivity = 200
lower_cutoff_freq = 40
higher_cutoff_freq = 12000

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
bar_delimiter = 0

[smoothing]
noise_reduction = 30
monstercat = 1
waves = 0
