    // ProtonPlus: frosted glass (menu giu nen dac)
    window-rule {
        match app-id="^protonplus$"
        opacity 0.95
        background-effect {
            blur true
        }
        popups {
            background-effect {
                blur false
            }
        }
    }

    // Catch-all: blur cho moi window co nen trong suot (popups/menu giu nen dac)
    window-rule {
        background-effect {
            blur true
        }
        popups {
            background-effect {
                blur false
            }
        }
    }
