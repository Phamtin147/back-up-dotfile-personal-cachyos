animations {
        // workspace-switch cũ (giữ lại để tham khảo)
        // workspace-switch {
        //     spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        // }
        // Tắt animation chuyển workspace (chuyển ngay lập tức)
        // workspace-switch {
        //     off
        // }
        // Tắt animation di chuyển ngang - vuốt nhảy luôn
        // horizontal-view-movement {
        //     off
        // }

        // bounce effect khi mở cửa sổ
        window-open {
            custom-shader r"

            // Ported from skwd-wall bounce transition

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float PI = 3.14159265358;
                float bounces = 3.0;

                float time = p;
                float stime = sin(time * PI / 2.0);
                float phase = time * PI * bounces;
                float yy = (abs(cos(phase))) * (1.0 - stime);
                float d = uv.y - yy;

                vec2 sample_uv = uv;
                sample_uv.y = uv.y + (1.0 - yy);
                vec3 tc = niri_geo_to_tex * vec3(sample_uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                float reveal = step(d, 0.0);
                return win * reveal;
            }
            "
            duration-ms 500
            curve "ease-out-cubic"
        }
        // bounce effect khi đóng cửa sổ
        window-close {
            custom-shader r"

            // Ported from skwd-wall bounce transition

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                float PI = 3.14159265358;
                float bounces = 3.0;

                float time = p;
                float stime = sin(time * PI / 2.0);
                float phase = time * PI * bounces;
                float yy = (abs(cos(phase))) * (1.0 - stime);
                float d = uv.y - yy;

                vec2 sample_uv = uv;
                sample_uv.y = uv.y + (1.0 - yy);
                vec3 tc = niri_geo_to_tex * vec3(sample_uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                float reveal = step(d, 0.0);
                return win * reveal;
            }
            "
            duration-ms 500
            curve "ease-out-cubic"
        }

        // Di chuyển cửa sổ
        window-movement {
            spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        }
        // Thay đổi kích thước cửa sổ
        window-resize {
            spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
        }
        // Thông báo cấu hình
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
        }
        // Giao diện chụp màn hình
        screenshot-ui-open {
            duration-ms 200
            curve "ease-out-quad"
        }
        // Chế độ xem tổng quan (Overview) - Cần mượt và bay bổng
        overview-open-close {
            spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
        }
    }
