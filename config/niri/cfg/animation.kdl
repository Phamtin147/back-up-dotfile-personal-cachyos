animations {
        // workspace-switch cũ (giữ lại để tham khảo)
        // workspace-switch {
        //     spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        // }
        // // Tắt animation chuyển workspace (chuyển ngay lập tức)
        // workspace-switch {
        //     off
        // }
        // // Tắt animation di chuyển ngang - vuốt nhảy luôn
        // horizontal-view-movement {
        //     off
        // }

        // crosshatch effect khi mở cửa sổ
        window-open {
            custom-shader r"

            // Ported from skwd-wall crosshatch transition

            float crosshatch_rand(vec2 co) {
                return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                vec2 center = vec2(0.5);
                float threshold = 3.0;
                float fadeEdge = 0.1;
                float dist = distance(center, uv) / threshold;
                float r = p - min(crosshatch_rand(vec2(uv.y, 0.0)), crosshatch_rand(vec2(0.0, uv.x)));
                float reveal = mix(0.0, mix(step(dist, r), 1.0, smoothstep(1.0 - fadeEdge, 1.0, p)), smoothstep(0.0, fadeEdge, p));

                return win * reveal;
            }
            "
            duration-ms 500
            curve "ease-out-cubic"
        }
        // crosshatch effect khi đóng cửa sổ
        window-close {
            custom-shader r"

            // Ported from skwd-wall crosshatch transition

            float crosshatch_rand(vec2 co) {
                return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                vec2 center = vec2(0.5);
                float threshold = 3.0;
                float fadeEdge = 0.1;
                float dist = distance(center, uv) / threshold;
                float r = p - min(crosshatch_rand(vec2(uv.y, 0.0)), crosshatch_rand(vec2(0.0, uv.x)));
                float reveal = mix(0.0, mix(step(dist, r), 1.0, smoothstep(1.0 - fadeEdge, 1.0, p)), smoothstep(0.0, fadeEdge, p));

                return win * reveal;
            }
            "
            duration-ms 500
            curve "ease-out-cubic"
        }

        // Di chuyển cửa sổ
        window-movement {
            spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        }
        // Thay đổi kích thước cửa sổ
        window-resize {
            spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
        }
        // Thông báo cấu hình
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
        }
        // Giao diện chụp màn hình
        screenshot-ui-open {
            duration-ms 200
            curve "ease-out-quad"
        }
        // Chế độ xem tổng quan (Overview) - Cần mượt và bay bổng
        overview-open-close {
            spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
        }
    }
