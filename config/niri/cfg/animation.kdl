animations {
        // workspace-switch cũ (giữ lại để tham khảo)
        // workspace-switch {
        //     spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        // }
        // Tắt animation chuyển workspace (chuyển ngay lập tức)
        // workspace-switch {
        //     off
        // }
        // Tắt animation di chuyển ngang - vuốt nhảy luôn
        // horizontal-view-movement {
        //     off
        // }

        // CRT TV Turn-on effect khi mở cửa sổ
        window-open {
            custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;

                float t_x = clamp(p / 0.35, 0.001, 1.0);
                float t_y = clamp((p - 0.2) / 0.8, 0.001, 1.0);

                vec2 center = vec2(0.5);
                vec2 st = (uv - center) / vec2(t_x, t_y) + center;

                if (st.x < 0.0 || st.x > 1.0 || st.y < 0.0 || st.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 tc = niri_geo_to_tex * vec3(st, 1.0);
                vec4 col = texture2D(niri_tex, tc.st);

                float flash = (1.0 - t_y) * 0.35;
                col.rgb = clamp(col.rgb + vec3(flash), 0.0, 1.0);

                return col;
            }
            "
            duration-ms 450
            curve "ease-out-quad"
        }
        // CRT TV Shutdown effect (tắt TV thập niên 90-2000) khi đóng cửa sổ
        window-close {
            custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - niri_clamped_progress;
                vec2 uv = coords_geo.xy;

                float t_y = clamp(p / 0.65, 0.001, 1.0);
                float t_x = clamp((p - 0.1) / 0.9, 0.001, 1.0);

                vec2 center = vec2(0.5);
                vec2 st = (uv - center) / vec2(t_x, t_y) + center;

                if (st.x < 0.0 || st.x > 1.0 || st.y < 0.0 || st.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 tc = niri_geo_to_tex * vec3(st, 1.0);
                vec4 col = texture2D(niri_tex, tc.st);

                float flash = (1.0 - t_y) * 0.45;
                col.rgb = clamp(col.rgb + vec3(flash), 0.0, 1.0);

                return col;
            }
            "
            duration-ms 400
            curve "ease-out-quad"
        }

        // Di chuyển cửa sổ
        window-movement {
            spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
        }
        // Thay đổi kích thước cửa sổ
        window-resize {
            spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
        }
        // Thông báo cấu hình
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
        }
        // Giao diện chụp màn hình
        screenshot-ui-open {
            duration-ms 200
            curve "ease-out-quad"
        }
        // Chế độ xem tổng quan (Overview) - Cần mượt và bay bổng
        overview-open-close {
            spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
        }
    }
