// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit
    spawn-sh-at-startup "qs -c noctalia-shell" // Noctalia shell (lock screen, wallpaper, notifications)
    // Skwd shell: bar/launcher/power/switch được quản lý bởi skwd-daemon (systemd user service)
    //   systemctl --user status skwd-daemon