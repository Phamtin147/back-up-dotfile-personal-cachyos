// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "us" // Use the American keyboard layout
        }
        numlock // Enable numlock on startup
    }

    touchpad {
        tap // Enable tap-to-click
        drag-lock // Maintain drag even if fingers momentarily lift or reach edges
        natural-scroll // Enable natural (macOS-style) scrolling
        click-method "clickfinger" // Click with 1, 2, 3 fingers matching hyper repo
        accel-speed 0.0 // Neutral comfortable pointer speed
        accel-profile "adaptive"
        scroll-factor 0.35 // Gentle comfortable scrolling speed
    }

    mouse {
        // scroll-factor 0.5 // Adjust this value for slower/faster scrolling (default 1.0)
    }

    //focus-follows-mouse // Automatically focus windows under the mouse pointer
    workspace-auto-back-and-forth // Enable workspace back & forth switching
}