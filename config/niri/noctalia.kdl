layout {

    focus-ring {
        active-color   "#e7bb64"
        inactive-color "#292214"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e7bb64"
        inactive-color "#292214"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29221470"
    }

    tab-indicator {
        active-color   "#e7bb64"
        inactive-color "#453921"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e7bb6480"
    }
}

recent-windows {
    highlight {
        active-color "#e7bb64"
        urgent-color "#fd4663"
    }
}
