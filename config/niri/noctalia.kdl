layout {

    focus-ring {
        active-color   "#5a5f68"
        inactive-color "#fcf8f9"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#5a5f68"
        inactive-color "#fcf8f9"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#5a5f68"
        inactive-color "#f0eded"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#5a5f6880"
    }
}

recent-windows {
    highlight {
        active-color "#5a5f68"
        urgent-color "#ba1a1a"
    }
}
