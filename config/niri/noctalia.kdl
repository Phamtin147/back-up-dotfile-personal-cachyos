layout {

    focus-ring {
        active-color   "#c2c6d1"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c2c6d1"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c2c6d1"
        inactive-color "#201f20"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c2c6d180"
    }
}

recent-windows {
    highlight {
        active-color "#c2c6d1"
        urgent-color "#ffb4ab"
    }
}
