layout {

    focus-ring {
        active-color   "#e3bdbe"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e3bdbe"
        inactive-color "#151313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e3bdbe"
        inactive-color "#221f1f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e3bdbe80"
    }
}

recent-windows {
    highlight {
        active-color "#e3bdbe"
        urgent-color "#ffb4ab"
    }
}
