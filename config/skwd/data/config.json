{
  "components": {
    "appLauncher": {
      "cornerRadius": 16,
      "displayMode": "slice",
      "expandedWidth": 360,
      "gridColumns": 6,
      "gridRows": 3,
      "roundCorners": false,
      "skewOffset": 16,
      "sliceHeight": 203,
      "sliceSpacing": -30,
      "sliceWidth": 52,
      "visibleCount": 20
    },
    "bar": {
      "bluetooth": true,
      "calendar": true,
      "enabled": true,
      "music": {
        "autohide": true,
        "cleanVisualizer": true,
        "enabled": true,
        "preferredPlayer": "spotify",
        "showLyrics": true,
        "showMeta": true,
        "visualizer": "wave",
        "visualizerBottom": true,
        "visualizerTop": true
      },
      "pillSideMargin": 12,
      "pillTopMargin": 8,
      "style": "classic",
      "volume": true,
      "weather": {
        "enabled": false
      },
      "wifi": {
        "enabled": true,
        "interface": ""
      }
    }
  },
  "compositor": "niri",
  "intervals": {
    "weatherPollMs": 3600000,
    "wifiPollMs": 10000
  },
  "monitor": "eDP-1",
  "paths": {
    "cache": "~/.cache/skwd",
    "splash": "~/appsplash"
  },
  "switcher": {
    "animFadeIn": 400,
    "cardHeightPad": 40,
    "cardWidth": 1600,
    "dimOpacity": 0.5,
    "displayMode": "slice",
    "gridColumns": 5,
    "gridRows": 4,
    "sliceExpandedWidth": 924,
    "sliceHeight": 520,
    "sliceSkewOffset": 35,
    "sliceSpacing": -22,
    "sliceVisibleCount": 12,
    "sliceWidth": 135
  },
  "terminal": "alacritty",
  "uiScale": 1
}
