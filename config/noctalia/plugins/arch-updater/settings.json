{
  "systemCmd": "checkupdates 2>/dev/null",
  "aurCmd": "paru -Qua 2>/dev/null",
  "updateCmd": "alacritty -e bash -c 'echo \"Updating System...\";paru; flatpak update; read -n 1 -p \"Press any key to exit...\"'",
  "aurHomepageCmd": "LC_ALL=C paru -Si {id} 2>/dev/null | awk '/^URL/ {print $3}'",
  "flatpak": false,
  "noctalia": false,
  "toast": false,
  "desktopTip": true,
  "hideOnEmpty": false,
  "refreshTimer": false,
  "refreshInterval": 120,
  "iconName": "arrow-big-down-lines",
  "useDistroLogo": false,
  "customIconPath": "",
  "boldText": false,
  "enableColorization": false,
  "iconColor": "none",
  "boldVer": true,
  "tooltip": false,
  "closeButton": false,
  "closeOnSettings": false,
  "panelTooltip": false,
  "panelContext": false,
  "boldVerPanel": false,
  "boldVerDesktop": false,
  "hoverTip": false
}
